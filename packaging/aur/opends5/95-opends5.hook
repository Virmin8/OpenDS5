# Runs after 20-systemd-sysusers (creates the vds group), which the package's
# install scriptlet runs too early for.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/vdsd

[Action]
Description = Setting up OpenDS5 (vhci-hcd driver, vds group, vdsd service)...
When = PostTransaction
Exec = /usr/share/opends5/pacman-setup.sh
