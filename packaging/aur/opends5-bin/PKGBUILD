# Maintainer: Virmin8 <59330972+Virmin8@users.noreply.github.com>

# Repackages the release AppImage: nothing is compiled except the vds_hcd kernel
# module, which DKMS builds for the installed kernels.
pkgname=opends5-bin
pkgver=1.9.3
pkgrel=1
pkgdesc='DualSense companion app and Bluetooth-to-USB bridge (haptics, adaptive triggers, speaker)'
arch=(x86_64)
url='https://github.com/Virmin8/OpenDS5'
license=(AGPL-3.0-only MIT)
depends=(dkms bluez bluez-libs dbus opus systemd-libs gcc-libs glibc pipewire
         gtk3 nss alsa-lib hicolor-icon-theme)
optdepends=('wireplumber: names the virtual controller audio device and sets its channels')
provides=("opends5=$pkgver" "opends5-dkms=$pkgver")
conflicts=(opends5 opends5-dkms)
options=(!strip !debug)
install=opends5.install
source=("OpenDS5-$pkgver.AppImage::$url/releases/download/v$pkgver/OpenDS5-Companion-Setup-$pkgver.AppImage"
        opends5-bin.sh
        opends5.desktop
        opends5.sysusers
        opends5-modules-load.conf
        95-opends5.hook
        pacman-setup.sh)
noextract=("OpenDS5-$pkgver.AppImage")
sha256sums=('53a1f9daafb3b622705bea5e3d92fbe005ed375d483cd84db943398f2bb02592'
            '3ea5ed7a5469227808b9eec840ff2d3edd2aab530f805c01cc57bd7d80e1b745'
            '186bfa5d777c54add852220c578846a80d242e7cbee6608d4804a1193d9456c8'
            '134e83a1587b4c2251430ced60f3211e7c6a355c8ee0602e908d00983b313cfa'
            '5554373b4a2907063636255caf2ebdc4056ae5c9858876a91392a16766eebd9e'
            '41c917458c771ae1803bd20a089d758ba7914e077f976c5b7229e219d993fafe'
            '02401e946d12ecae7b0c14d94c107d08e68379991c86020d981eea9b0d1f1113')

prepare() {
  chmod +x "OpenDS5-$pkgver.AppImage"
  rm -rf squashfs-root
  "./OpenDS5-$pkgver.AppImage" --appimage-extract > /dev/null
}

package() {
  local app="$srcdir/squashfs-root"
  local res="$app/resources"

  # The Electron app as shipped in the AppImage, minus the AppImage wrapper files.
  install -d "$pkgdir/opt/opends5"
  cp -a "$app/." "$pkgdir/opt/opends5/"
  rm -rf "$pkgdir/opt/opends5/"{AppRun,.DirIcon,ds5-bridge.desktop,ds5-bridge.png,usr}
  chmod -R u+rwX,go+rX,go-w "$pkgdir/opt/opends5"
  chmod 4755 "$pkgdir/opt/opends5/chrome-sandbox"

  install -Dm755 "$srcdir/opends5-bin.sh" "$pkgdir/usr/bin/opends5"
  install -Dm644 "$srcdir/opends5.desktop" "$pkgdir/usr/share/applications/opends5.desktop"
  install -Dm644 "$res/assets/controllers/opends5_app-icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/opends5.png"

  # vdsd daemon and vdsctl CLI (prebuilt in CI on Ubuntu 22.04)
  install -Dm755 "$res/vds-bin/vdsd" "$pkgdir/usr/bin/vdsd"
  install -Dm755 "$res/vds-bin/vdsctl" "$pkgdir/usr/bin/vdsctl"
  sed 's|@VDS_SYSTEMD_VDSD@|/usr/bin/vdsd|' "$res/vds-bin/vdsd.service.in" |
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/vdsd.service"
  install -Dm644 "$res/vds-bin/99-vds-dualsense-udev.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-vds-dualsense.rules"
  install -Dm644 "$res/vds-bin/99-vds-dualsense-wireplumber.conf" \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/99-vds-dualsense.conf"
  # vdsd runs this to switch bluetoothd between OpenDS5 and Normal mode.
  install -Dm755 "$res/vds-bin/override-bluetoothd.sh" "$pkgdir/usr/share/opends5/override-bluetoothd.sh"
  # After the DKMS build: add the installing user to vds, load vds_hcd, start vdsd.
  install -Dm644 "$srcdir/95-opends5.hook" "$pkgdir/usr/share/libalpm/hooks/95-opends5.hook"
  install -Dm755 "$srcdir/pacman-setup.sh" "$pkgdir/usr/share/opends5/pacman-setup.sh"
  # vdsd gives the vds group access to its control socket.
  install -Dm644 "$srcdir/opends5.sysusers" "$pkgdir/usr/lib/sysusers.d/opends5.conf"

  # Kernel module source; the dkms package's pacman hook builds and installs it.
  install -d "$pkgdir/usr/src/vds_hcd-$pkgver"
  cp -a "$res/vds-module/." "$pkgdir/usr/src/vds_hcd-$pkgver/"
  chmod -R u+rwX,go+rX,go-w "$pkgdir/usr/src/vds_hcd-$pkgver"
  install -Dm644 "$srcdir/opends5-modules-load.conf" "$pkgdir/usr/lib/modules-load.d/opends5.conf"

  install -Dm644 "$app/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$app/LICENSE.electron.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
}
