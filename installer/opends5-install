#!/usr/bin/env bash
# OpenDS5 system installer: installs vdsd and loads the in-tree vhci_hcd
# (USB/IP) driver it plugs the virtual controllers into. Older releases built
# an out-of-tree vds_hcd module with DKMS; this installer removes that.
# Spec: docs/superpowers/specs/2026-07-11-system-installer-design.md
set -euo pipefail

# --- injectable environment (tests override these) ---
OS_RELEASE="${OPENDS5_OS_RELEASE:-/etc/os-release}"
KERNEL_RELEASE="${OPENDS5_UNAME_R:-$(uname -r)}"
SYSROOT="${OPENDS5_SYSROOT:-}"           # prefix for /sys, /run, /usr probes
DRY_RUN="${OPENDS5_DRY_RUN:-0}"
ASSUME_YES=0
JSON_PROGRESS=0
UNINSTALL=0
PURGE=0
# Accepted for compatibility (the companion passes it after an app update);
# userspace is always reinstalled, there is no module to rebuild any more.
REBUILD_MODULE=0
APP_VER="${OPENDS5_MODULE_VERSION:-${OPENDS5_APP_VERSION:-unknown}}"

user_log_dir() { echo "${OPENDS5_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/opends5}"; }
root_log_dir() { echo "${OPENDS5_LOG_DIR:-/var/log/opends5}"; }
log_path() { echo "$(user_log_dir)/install.log"; }

log_header() { # target_file
  {
    printf '=== opends5-install run %s ===\n' "$(date -Is)"
    printf 'version=%s platform=%s kernel=%s flavor=%s sb=%s lockdown=%s\n' \
      "$APP_VER" "$(detect_platform)" "$KERNEL_RELEASE" \
      "$(detect_kernel_flavor)" "$(detect_secureboot)" "$(detect_lockdown)"
  } >> "$1"
}

os_release_val() { # key -> value (unquoted), empty if absent
  sed -n "s/^$1=//p" "$OS_RELEASE" 2>/dev/null | tr -d '"' | head -n1
}

detect_platform() {
  local id like
  id="$(os_release_val ID)"
  like="$(os_release_val ID_LIKE)"
  if [ "$id" = "nixos" ]; then echo nixos; return; fi
  case " $id $like " in
    *" fedora "*)
      if [ -e "${SYSROOT}/run/ostree-booted" ]; then echo fedora-immutable; else echo fedora; fi ;;
    *" arch "*)   echo arch ;;
    *" debian "*|*" ubuntu "*) echo debian ;;
    *" suse "*|*" opensuse "*) echo suse ;;
    *) echo unsupported ;;
  esac
}

detect_kernel_flavor() {
  case "$KERNEL_RELEASE" in
    # CachyOS ships per-variant packages (linux-cachyos-bore, kernel-cachyos-lts…),
    # so keep the full variant suffix instead of collapsing to "cachyos".
    *cachyos*)  echo "$KERNEL_RELEASE" | sed -n 's/.*-\(cachyos[a-z-]*\).*/\1/p' | sed 's/-$//' ;;
    *xanmod*)   echo xanmod ;;
    *-lqx*)     echo lqx ;;
    *fsync*)    echo fsync ;;
    *zen*)      echo zen ;;
    *hardened*) echo hardened ;;
    *-rt*)      echo rt ;;
    *lts*)      echo lts ;;
    *)          echo generic ;;
  esac
}

# Package that provides vhci-hcd.ko when the running kernel's base package does
# not (empty: it ships with the kernel). Only installed if modprobe fails.
vhci_package() { # platform
  case "$1" in
    debian)                   echo "linux-modules-extra-${KERNEL_RELEASE}" ;;
    fedora|fedora-immutable)  echo "kernel-modules-extra-${KERNEL_RELEASE}" ;;
    *)                        echo "" ;;
  esac
}

detect_lockdown() {
  local f="${SYSROOT}/sys/kernel/security/lockdown"
  [ -r "$f" ] || { echo none; return; }
  sed -n 's/.*\[\(.*\)\].*/\1/p' "$f"
}

detect_secureboot() {
  if [ -n "${OPENDS5_SB_STATE:-}" ]; then
    if [ "$OPENDS5_SB_STATE" = "enabled" ]; then echo 1; else echo 0; fi
    return
  fi
  if command -v mokutil >/dev/null 2>&1 && mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    echo 1
  else
    echo 0
  fi
}

PLAN_DESC=()
PLAN_CMD=()
PLAN_FATAL=""
PLAN_NIXOS=0

plan_add() { PLAN_DESC+=("$1"); PLAN_CMD+=("$2"); }

# A leftover out-of-tree vds_hcd from an earlier release (loaded, registered
# with DKMS, or its sources staged).
detect_legacy_module() {
  if [ -d "${SYSROOT}/sys/module/vds_hcd" ]; then echo 1; return; fi
  if compgen -G "${SYSROOT}/usr/src/vds_hcd-*" >/dev/null; then echo 1; return; fi
  if [ -z "$SYSROOT" ] && command -v dkms >/dev/null 2>&1 && \
     dkms status vds_hcd 2>/dev/null | grep -q .; then echo 1; return; fi
  echo 0
}

# Shell snippet that removes the legacy module everywhere it can live.
LEGACY_REMOVE_CMD="modprobe -r vds_hcd >/dev/null 2>&1 || true; \
     if command -v dkms >/dev/null 2>&1; then dkms status vds_hcd 2>/dev/null | sed -n 's|^vds_hcd[/,] *\\([^,:]*\\).*|\\1|p' | sort -u | while read -r v; do [ -n \"\$v\" ] && dkms remove \"vds_hcd/\$v\" --all || true; done; fi; \
     rm -rf /usr/src/vds_hcd-*"

VHCI_BOOT_CMD="printf '# OpenDS5: virtual controllers are plugged in over USB/IP\\nvhci-hcd\\n' > /etc/modules-load.d/vds.conf"

plan_legacy_cleanup() {
  [ "$(detect_legacy_module)" = "1" ] || return 0
  plan_add "Stop vdsd and remove the old out-of-tree vds_hcd module (DKMS)" \
    "systemctl stop vdsd.service >/dev/null 2>&1 || true; ${LEGACY_REMOVE_CMD}"
}

plan_vhci() { # platform
  local pkg install=""
  pkg="$(vhci_package "$1")"
  case "$1" in
    debian)  [ -n "$pkg" ] && install="apt-get install -y ${pkg}" ;;
    fedora)  [ -n "$pkg" ] && install="dnf install -y ${pkg}" ;;
  esac
  if [ -n "$install" ]; then
    plan_add "Load the in-tree vhci-hcd USB/IP driver (installing ${pkg} if needed)" \
      "modprobe vhci-hcd 2>/dev/null || { ${install} && modprobe vhci-hcd; }"
  else
    plan_add "Load the in-tree vhci-hcd USB/IP driver" "modprobe vhci-hcd"
  fi
  plan_add "Load vhci-hcd on boot" "${VHCI_BOOT_CMD}"
}

USERSPACE_SRC=""

resolve_userspace_source() {
  local script_dir cand
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # An explicit override wins outright: if it names a directory without a
  # bundle, the userspace phase is off (no silent fallback to the repo).
  if [ -n "${OPENDS5_USERSPACE_DIR:-}" ]; then
    if [ -f "${OPENDS5_USERSPACE_DIR}/vdsd" ] && [ -f "${OPENDS5_USERSPACE_DIR}/vdsd.service.in" ]; then
      USERSPACE_SRC="$OPENDS5_USERSPACE_DIR"
    fi
    return
  fi
  for cand in "${APPDIR:-/nonexistent}/resources/vds-bin" "$script_dir/../vds-bin"; do
    if [ -f "$cand/vdsd" ] && [ -f "$cand/vdsd.service.in" ]; then
      USERSPACE_SRC="$cand"; return
    fi
  done
}

STAGE_DIR=""
ICON_SRC=""

cleanup_stage() { [ -n "$STAGE_DIR" ] && rm -rf "$STAGE_DIR"; }

resolve_icon_source() {
  local cand
  for cand in "${APPDIR:-/nonexistent}/resources/assets/controllers/opends5_app-icon.png" \
              "${APPDIR:-/nonexistent}/resources/assets/controllers/opends5_mark.png"; do
    if [ -f "$cand" ]; then ICON_SRC="$cand"; return; fi
  done
}

# AppImage FUSE mounts (/tmp/.mount_*) are readable only by the user that
# mounted them — the escalated half of the run cannot see inside. Copy the
# bundled sources out to a root-readable staging dir while still unprivileged.
needs_root_staging() {
  case "${USERSPACE_SRC}:${ICON_SRC}" in
    /tmp/.mount_*|*:/tmp/.mount_*) echo 1; return ;;
  esac
  if [ -n "${APPDIR:-}" ]; then echo 1; else echo 0; fi
}

stage_sources_for_root() {
  [ "$(needs_root_staging)" = "1" ] || return 0
  STAGE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/opends5-stage.XXXXXX")"
  chmod 0755 "$STAGE_DIR"
  trap cleanup_stage EXIT
  if [ -n "$USERSPACE_SRC" ]; then
    cp -a "$USERSPACE_SRC" "$STAGE_DIR/vds-bin"
    chmod -R a+rX "$STAGE_DIR/vds-bin"
    USERSPACE_SRC="$STAGE_DIR/vds-bin"
  fi
  if [ -n "$ICON_SRC" ]; then
    cp -a "$ICON_SRC" "$STAGE_DIR/opends5-icon.png"
    chmod 0644 "$STAGE_DIR/opends5-icon.png"
    ICON_SRC="$STAGE_DIR/opends5-icon.png"
  fi
}

detect_vhci_loaded() {
  if [ -d "${SYSROOT}/sys/module/vhci_hcd" ]; then echo 1; else echo 0; fi
}

plan_userspace() {
  [ -n "$USERSPACE_SRC" ] || return 0
  local user home
  user="$(id -un)"
  home="$HOME"
  plan_add "Install vdsd and vdsctl to /usr/local/bin" \
    "install -m 0755 '${USERSPACE_SRC}/vdsd' '${USERSPACE_SRC}/vdsctl' /usr/local/bin/"
  plan_add "Install systemd unit and udev rules" \
    "sed 's|@VDS_SYSTEMD_VDSD@|/usr/local/bin/vdsd|' '${USERSPACE_SRC}/vdsd.service.in' > /etc/systemd/system/vdsd.service && \
     install -m 0644 '${USERSPACE_SRC}/99-vds-dualsense-udev.rules' /etc/udev/rules.d/ && \
     udevadm control --reload-rules && { udevadm trigger --subsystem-match=input || true; }"
  plan_add "Create vds group and add ${user}" \
    "groupadd -f vds && usermod -aG vds '${user}'"
  plan_add "Install wireplumber config for ${user}" \
    "mkdir -p '${home}/.config/wireplumber/wireplumber.conf.d' && \
     install -m 0644 '${USERSPACE_SRC}/99-vds-dualsense-wireplumber.conf' '${home}/.config/wireplumber/wireplumber.conf.d/' && \
     chown -R '${user}:' '${home}/.config/wireplumber'"
  # vdsd's Bluetooth mode switch (OpenDS5 <-> normal) runs the installed
  # override script, so it is always installed even when the plugin is already off.
  # vds needs raw ownership of the controller's HID L2CAP channels; BlueZ's
  # input plugin claims them first and the app never sees the controller.
  # Trade-off (upstream vds limitation): other BT input devices stop working.
  if [ -f "${USERSPACE_SRC}/override-bluetoothd.sh" ]; then
    plan_add "Disable the BlueZ input plugin (vds owns the controller; BT keyboards/mice stop working)" \
      "install -D -m 0755 '${USERSPACE_SRC}/override-bluetoothd.sh' /usr/share/opends5/override-bluetoothd.sh && \
       if systemctl show -p ExecStart bluetooth 2>/dev/null | grep -q 'noplugin=input'; then \
         echo 'BlueZ input plugin already disabled'; \
       else \
         bash /usr/share/opends5/override-bluetoothd.sh disable-input --restart; \
       fi"
  fi
  plan_add "Reload systemd" "systemctl daemon-reload"
}

# When run from an AppImage, install it to ~/Applications and give the user a
# real launcher, so they never have to place the file or write a .desktop by hand.
plan_desktop_entry() {
  local src="${APPIMAGE:-}"
  [ -n "$src" ] && [ -f "$src" ] || return 0
  local user home apps dest desktop icon_dir icon_src icon_dest
  user="$(id -un)"
  home="$HOME"
  apps="$home/Applications"
  dest="$apps/OpenDS5.AppImage"
  desktop="$home/.local/share/applications/opends5.desktop"
  icon_dir="$home/.local/share/icons/hicolor/256x256/apps"
  icon_dest="$icon_dir/opends5.png"
  # Staged out of the AppImage mount already (root cannot read inside it).
  icon_src="$ICON_SRC"

  plan_add "Install OpenDS5 to ${apps} and add it to your applications menu" \
    "mkdir -p '${apps}' '${icon_dir}' '$(dirname "$desktop")' && \
     if [ '${src}' != '${dest}' ]; then install -m 0755 '${src}' '${dest}'; fi && \
     ${icon_src:+install -m 0644 '${icon_src}' '${icon_dest}' && } \
     printf '%s\n' \
       '[Desktop Entry]' \
       'Type=Application' \
       'Name=OpenDS5' \
       'GenericName=DualSense Bridge' \
       'Comment=DualSense haptics, triggers and remapping over Bluetooth' \
       'Exec=${dest}' \
       'Icon=${icon_src:+${icon_dest}}' \
       'Terminal=false' \
       'Categories=Game;' \
       'StartupWMClass=OpenDS5' \
       > '${desktop}' && \
     chmod 0644 '${desktop}' && \
     chown '${user}:' '${dest}' '${desktop}' ${icon_src:+'${icon_dest}'} && \
     { update-desktop-database '$(dirname "$desktop")' >/dev/null 2>&1 || true; }"
}

plan_driver_and_userspace() { # platform
  plan_legacy_cleanup
  if [ "$(detect_vhci_loaded)" = "1" ]; then
    plan_add "vhci-hcd already loaded; making sure it loads on boot" "${VHCI_BOOT_CMD}"
  else
    plan_vhci "$1"
  fi
  plan_userspace
  plan_desktop_entry
}

build_plan() {
  local platform
  platform="$(detect_platform)"
  if [ "${OPENDS5_TEST_ONLY_INJECTED:-0}" = "1" ]; then
    plan_add "test-injected failure" "${OPENDS5_TEST_INJECT_FAIL:-true}"
    return
  fi
  case "$platform" in
    fedora|arch|debian|suse)
      plan_driver_and_userspace "$platform" ;;
    fedora-immutable)
      # vhci-hcd ships in kernel-modules-extra; layering it needs a reboot.
      plan_legacy_cleanup
      if [ "$(detect_vhci_loaded)" != "1" ]; then
        plan_add "Load vhci-hcd, layering kernel-modules-extra if needed (rpm-ostree; REBOOT REQUIRED if layered)" \
          "modprobe vhci-hcd 2>/dev/null || rpm-ostree install --idempotent kernel-modules-extra"
      fi
      plan_add "Load vhci-hcd on boot" "${VHCI_BOOT_CMD}"
      plan_userspace
      plan_desktop_entry ;;
    nixos)
      PLAN_NIXOS=1
      plan_add "Generate NixOS module snippet ./opends5-vds.nix (no system changes)" "generate_nixos_snippet" ;;
    *)
      PLAN_FATAL="This distribution is unsupported by the automatic installer.
See docs/PORTING.md for manual installation instructions." ;;
  esac
  if [ -n "${OPENDS5_TEST_INJECT_FAIL:-}" ]; then
    plan_add "test-injected failure" "$OPENDS5_TEST_INJECT_FAIL"
  fi
}

as_root() {
  if [ -n "${OPENDS5_ROOT_CMD:-}" ]; then "$OPENDS5_ROOT_CMD" "$@"; return; fi
  if [ "$(id -u)" -eq 0 ]; then "$@"; return; fi
  if command -v pkexec >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    pkexec "$@"
  else
    sudo "$@"
  fi
}

# Emit one root-executed runner script for the whole plan, so the user
# authenticates exactly once. Fail-closed: the first failing step stops the
# run and exits 4.
build_runner() { # path
  {
    printf '#!/usr/bin/env bash\nset -u\n'
    printf 'mkdir -p %q\n' "$(root_log_dir)"
    printf 'RLOG=%q\n' "$(root_log_dir)/install.log"
    printf 'log() { printf "%%s\\n" "$*" >> "$RLOG"; }\n'
    printf 'fail() {\n'
    printf '  echo "FAILED: $1" >&2\n'
    printf '  echo "  Retry manually with: sudo bash -c \\"$2\\"" >&2\n'
    printf '  echo "  Full log: $RLOG" >&2\n'
    printf '  echo "  Troubleshooting: https://github.com/LordVicky/OpenDS5/blob/main/docs/INSTALLER.md" >&2\n'
    printf '  log "FAILED: $1"\n'
    printf '  exit 4\n}\n'
    printf 'fail_quiet() { log "FAILED: $1"; exit 4; }\n'
    printf 'log "=== opends5-install run $(date -Is) ==="\n'
    printf 'log %q\n' "version=$APP_VER platform=$(detect_platform) kernel=$KERNEL_RELEASE flavor=$(detect_kernel_flavor) sb=$(detect_secureboot) lockdown=$(detect_lockdown)"
    local i
    for i in "${!PLAN_CMD[@]}"; do
      if [ "$JSON_PROGRESS" = "1" ]; then
        printf 'echo %q\n' "{\"event\":\"step\",\"index\":$i,\"status\":\"start\"}"
      else
        printf 'echo %q\n' "==> ${PLAN_DESC[$i]}"
      fi
      printf 'log %q\n' "STEP $((i + 1)): ${PLAN_DESC[$i]}"
      printf 'log %q\n' "CMD: ${PLAN_CMD[$i]}"
      printf '( %s ) >>"$RLOG" 2>&1; rc=$?\n' "${PLAN_CMD[$i]}"
      printf 'log "exit=$rc"\n'
      if [ "$JSON_PROGRESS" = "1" ]; then
        printf 'if [ "$rc" -eq 0 ]; then echo %q; else echo %q; fail_quiet %q; fi\n' \
          "{\"event\":\"step\",\"index\":$i,\"status\":\"ok\"}" \
          "{\"event\":\"step\",\"index\":$i,\"status\":\"fail\",\"exit\":4}" \
          "${PLAN_DESC[$i]}"
      else
        printf '[ "$rc" -eq 0 ] || fail %q %q\n' "${PLAN_DESC[$i]}" "${PLAN_CMD[$i]}"
      fi
    done
    if [ "${OPENDS5_SKIP_VERIFY:-0}" != "1" ]; then
      local say=""
      [ "$JSON_PROGRESS" = "1" ] && say=": " # suppress human chatter in JSON mode
      printf '%secho "==> Loading vhci-hcd"\nlog "STEP: modprobe vhci-hcd"\n' "$say"
      if [ "$(detect_platform)" = "fedora-immutable" ]; then
        # A freshly layered kernel-modules-extra only exists after a reboot.
        printf 'modprobe vhci-hcd >>"$RLOG" 2>&1 || { %secho "kernel-modules-extra was layered: reboot, and vhci-hcd will load automatically."; log "modprobe vhci-hcd: reboot pending"; exit 6; }\n' "$say"
      else
        printf 'modprobe vhci-hcd >>"$RLOG" 2>&1 || fail "Load vhci-hcd" "modprobe vhci-hcd"\n'
      fi
      # Start the daemon when it is already installed (daemon install itself
      # is out of scope for this installer until the userspace phase lands).
      printf 'if systemctl list-unit-files vdsd.service >/dev/null 2>&1 && systemctl cat vdsd.service >/dev/null 2>&1; then\n'
      printf '  %secho "==> Starting vdsd.service"\n  log "STEP: enable vdsd.service"\n' "$say"
      # restart, not just --now: an update replaces the vdsd binary (the USB
      # device model lives there), and a running daemon must pick it up.
      printf '  { systemctl enable vdsd.service && systemctl restart vdsd.service; } >>"$RLOG" 2>&1 || fail "Start vdsd.service" "systemctl enable vdsd.service && systemctl restart vdsd.service"\n'
      printf 'else\n'
      printf '  %secho "vdsd.service not installed yet; skipping daemon start"\n' "$say"
      printf 'fi\n'
    fi
  } > "$1"
}

confirm_and_execute() {
  if [ "$ASSUME_YES" != "1" ]; then
    printf 'Proceed? [Y/n] '
    read -r reply
    case "$reply" in n|N|no|NO) echo "Aborted."; exit 0 ;; esac
  fi
  if [ "$PLAN_NIXOS" = "1" ]; then
    # NixOS flow is entirely unprivileged.
    echo "==> ${PLAN_DESC[0]}"
    generate_nixos_snippet
    return 0
  fi
  mkdir -p "$(user_log_dir)"
  log_header "$(log_path)"
  print_plan >> "$(log_path)" 2>/dev/null || true
  local runner rc=0
  runner="$(mktemp)"
  build_runner "$runner"
  as_root bash "$runner" || rc=$?
  rm -f "$runner"
  if [ "$rc" -ne 0 ]; then
    [ "$JSON_PROGRESS" = "1" ] && printf '{"event":"done","exit":%d}\n' "$rc"
    exit "$rc"
  fi
  if [ "${OPENDS5_SKIP_VERIFY:-0}" != "1" ]; then verify_install; fi
  restart_wireplumber
  if [ "$JSON_PROGRESS" = "1" ]; then
    printf '{"event":"done","exit":0}\n'
  elif [ "${OPENDS5_SKIP_VERIFY:-0}" = "1" ]; then
    echo "Done (verify skipped)."
  fi
}

verify_install() {
  [ "$JSON_PROGRESS" = "1" ] || echo "==> Verifying"
  if [ -e "${SYSROOT}/sys/devices/platform/vhci_hcd.0/attach" ]; then
    [ "$JSON_PROGRESS" = "1" ] || echo "Success: vhci-hcd loaded; vdsd can plug in virtual controllers."
  else
    echo "vhci-hcd did not come up; check 'dmesg | grep vhci'." >&2
    [ "$JSON_PROGRESS" = "1" ] && printf '{"event":"done","exit":5}\n'
    exit 5
  fi
}
generate_nixos_snippet() {
  cat > ./opends5-vds.nix <<'NIX'
# OpenDS5 for NixOS: vdsd plugs its virtual controllers into the kernel's
# in-tree vhci-hcd (USB/IP) driver; no out-of-tree module is needed.
# Import from configuration.nix:  imports = [ ./opends5-vds.nix ];
# For the full stack (vdsd service, udev rules, wireplumber), prefer the
# OpenDS5 flake's nixosModules.opends5 (services.opends5.enable = true).
{ ... }:
{
  boot.kernelModules = [ "vhci-hcd" ];
}
NIX
  cat <<'MSG'
Wrote ./opends5-vds.nix.
NixOS cannot be modified imperatively; to install:
  1. Move it into your configuration directory.
  2. Add  imports = [ ./opends5-vds.nix ];  to configuration.nix
     (or use the OpenDS5 flake's nixosModules.opends5).
  3. Run: sudo nixos-rebuild switch
MSG
}

# --- uninstall: undo everything plan_userspace / plan_vhci / plan_desktop_entry did ---
plan_uninstall() {
  local user home apps
  user="$(id -un)"
  home="$HOME"
  apps="$home/Applications"
  plan_add "Stop and remove the vdsd service" \
    "systemctl disable --now vdsd.service >/dev/null 2>&1 || true; \
     rm -f /etc/systemd/system/vdsd.service && systemctl daemon-reload"
  # The installed copy is preferred; the bundled one covers a half-removed install.
  local bt_script="/usr/share/opends5/override-bluetoothd.sh"
  local bt_fallback=""
  [ -n "$USERSPACE_SRC" ] && [ -f "${USERSPACE_SRC}/override-bluetoothd.sh" ] && \
    bt_fallback="${USERSPACE_SRC}/override-bluetoothd.sh"
  plan_add "Re-enable the BlueZ input plugin (Bluetooth keyboards/mice/controllers work again)" \
    "if [ -f '${bt_script}' ]; then bash '${bt_script}' enable-input --restart; \
     elif [ -n '${bt_fallback}' ]; then bash '${bt_fallback}' enable-input --restart; \
     else echo 'override script not found; BlueZ input plugin left as is'; fi; \
     rm -rf /usr/share/opends5"
  # vhci-hcd stays loaded until reboot (other USB/IP users may need it); only
  # OpenDS5's boot entry and any legacy vds_hcd module are removed.
  plan_add "Stop loading vhci-hcd on boot and remove any old vds_hcd module" \
    "rm -f /etc/modules-load.d/vds.conf; ${LEGACY_REMOVE_CMD}"
  plan_add "Remove vdsd and vdsctl from /usr/local/bin" \
    "rm -f /usr/local/bin/vdsd /usr/local/bin/vdsctl"
  plan_add "Remove udev rules" \
    "rm -f /etc/udev/rules.d/99-vds-dualsense-udev.rules && udevadm control --reload-rules"
  plan_add "Remove the vds group" \
    "if getent group vds >/dev/null; then gpasswd -d '${user}' vds >/dev/null 2>&1 || true; groupdel vds; fi"
  plan_add "Remove vdsd state, socket and logs" \
    "rm -rf /var/lib/vds /run/vdsd.sock; rm -f /var/log/vdsd.log /var/log/vdsd.log.*"
  plan_add "Remove the wireplumber config for ${user}" \
    "rm -f '${home}/.config/wireplumber/wireplumber.conf.d/99-vds-dualsense-wireplumber.conf'"
  plan_add "Remove OpenDS5 from ${apps}, the applications menu and autostart" \
    "rm -f '${apps}/OpenDS5.AppImage' '${home}/.local/share/applications/opends5.desktop' \
           '${home}/.local/share/icons/hicolor/256x256/apps/opends5.png' \
           '${home}/.config/autostart/opends5.desktop'; \
     { update-desktop-database '${home}/.local/share/applications' >/dev/null 2>&1 || true; }"
  if [ "$PURGE" = "1" ]; then
    plan_add "Remove OpenDS5 app settings and installer logs" \
      "rm -rf '${home}/.config/OpenDS5' '$(user_log_dir)' '$(root_log_dir)'"
  fi
}

# Uninstall runs every step even if one fails (a half-removed install must still
# be cleaned up as far as possible); the exit code reports whether all succeeded.
build_uninstall_runner() { # path
  {
    printf '#!/usr/bin/env bash\nset -u\n'
    printf 'RLOG=/dev/null\n'
    if [ "$PURGE" != "1" ]; then
      printf 'mkdir -p %q && RLOG=%q\n' "$(root_log_dir)" "$(root_log_dir)/uninstall.log"
    fi
    printf 'log() { printf "%%s\\n" "$*" >> "$RLOG"; }\n'
    printf 'failed=0\n'
    printf 'log "=== opends5-install --uninstall run $(date -Is) ==="\n'
    local i
    for i in "${!PLAN_CMD[@]}"; do
      if [ "$JSON_PROGRESS" = "1" ]; then
        printf 'echo %q\n' "{\"event\":\"step\",\"index\":$i,\"status\":\"start\"}"
      else
        printf 'echo %q\n' "==> ${PLAN_DESC[$i]}"
      fi
      printf 'log %q\n' "STEP $((i + 1)): ${PLAN_DESC[$i]}"
      printf '( %s ) >>"$RLOG" 2>&1; rc=$?\n' "${PLAN_CMD[$i]}"
      printf 'log "exit=$rc"\n'
      if [ "$JSON_PROGRESS" = "1" ]; then
        printf 'if [ "$rc" -eq 0 ]; then echo %q; else echo %q; failed=1; fi\n' \
          "{\"event\":\"step\",\"index\":$i,\"status\":\"ok\"}" \
          "{\"event\":\"step\",\"index\":$i,\"status\":\"fail\",\"exit\":7}"
      else
        printf 'if [ "$rc" -ne 0 ]; then echo %q >&2; failed=1; fi\n' "  step failed (continuing): ${PLAN_DESC[$i]}"
      fi
    done
    printf '[ "$failed" -eq 0 ] || exit 7\n'
  } > "$1"
}

# WirePlumber runs per user; restart it unprivileged so a config change applies
# now rather than at next login. Brief audio interruption; never fatal.
restart_wireplumber() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet wireplumber.service 2>/dev/null; then
    systemctl --user restart wireplumber.service >/dev/null 2>&1 || true
  fi
}

run_uninstall() {
  if [ "$ASSUME_YES" != "1" ]; then
    printf 'Remove OpenDS5 from this system? [y/N] '
    read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 0 ;; esac
  fi
  local runner rc=0
  runner="$(mktemp)"
  build_uninstall_runner "$runner"
  as_root bash "$runner" || rc=$?
  rm -f "$runner"
  restart_wireplumber
  if [ "$JSON_PROGRESS" = "1" ]; then
    printf '{"event":"done","exit":%d}\n' "$rc"
  elif [ "$rc" -eq 0 ]; then
    echo "OpenDS5 has been removed. Log out and back in to drop the vds group from your session."
  else
    echo "OpenDS5 was removed, but some steps failed; see $(root_log_dir)/uninstall.log." >&2
  fi
  exit "$rc"
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

emit_plan_json() {
  local steps="" i
  for i in "${!PLAN_DESC[@]}"; do
    steps="${steps}${steps:+,}\"$(json_escape "${PLAN_DESC[$i]}")\""
  done
  printf '{"event":"plan","total":%d,"steps":[%s],"log":"%s"}\n' \
    "${#PLAN_DESC[@]}" "$steps" "$(json_escape "$(root_log_dir)/install.log")"
}

print_plan() {
  local i
  echo "The following steps will be performed:"
  for i in "${!PLAN_DESC[@]}"; do
    printf '  %d. %s\n' "$((i + 1))" "${PLAN_DESC[$i]}"
  done
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) ASSUME_YES=1 ;;
      --dry-run) DRY_RUN=1 ;;
      --json-progress) JSON_PROGRESS=1 ;;
      --uninstall) UNINSTALL=1 ;;
      --rebuild-module) REBUILD_MODULE=1 ;;
      --purge) PURGE=1 ;;
      -h|--help) usage; exit 0 ;;
      *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
  done
  if [ "$UNINSTALL" = "1" ]; then
    resolve_userspace_source
    [ "$DRY_RUN" = "1" ] || stage_sources_for_root
    plan_uninstall
    if [ "$JSON_PROGRESS" = "1" ]; then emit_plan_json; else print_plan; fi
    if [ "$DRY_RUN" = "1" ]; then
      printf '%s\n' "${PLAN_CMD[@]}"
      exit 0
    fi
    run_uninstall
  fi
  resolve_userspace_source
  resolve_icon_source
  # Dry runs change nothing, so they report the real bundle paths.
  [ "$DRY_RUN" = "1" ] || stage_sources_for_root
  build_plan
  if [ -n "$PLAN_FATAL" ]; then echo "unsupported: $PLAN_FATAL" >&2; exit 3; fi
  if [ "$JSON_PROGRESS" = "1" ]; then emit_plan_json; else print_plan; fi
  if [ "$DRY_RUN" = "1" ]; then
    printf '%s\n' "${PLAN_CMD[@]}"
    exit 0
  fi
  confirm_and_execute
}

usage() {
  cat <<'EOF'
Usage: opends5-install [--yes] [--dry-run] [--json-progress] [--rebuild-module]
       opends5-install --uninstall [--purge] [--yes] [--dry-run]
Installs vdsd and loads the in-tree vhci-hcd (USB/IP) driver it uses, removing
the out-of-tree vds_hcd module of older releases. With --uninstall, removes
everything the installer set up (vdsd, udev rules, wireplumber config, BlueZ
override, vds group, app launcher, vhci-hcd boot entry). --purge also removes
app settings. --rebuild-module is accepted for compatibility and does nothing.
EOF
}

if [ "${OPENDS5_INSTALL_SOURCED:-0}" != "1" ]; then
  main "$@"
fi
